# Production configuration for docker-compose.yml. Copy to .env and fill in.
# NEVER commit .env.

# Public hostname. Point its DNS A/AAAA record at the server and open ports
# 80 and 443; Caddy then obtains the TLS certificate automatically.
# Use DOMAIN=localhost to try the production stack locally.
DOMAIN=quiz.example.com

POSTGRES_DB=curtisdb
POSTGRES_USER=curtisuser
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Entra ID app registration. Register this redirect URI (type "Web"):
#   https://<DOMAIN>/api/login/oauth2/code/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Optional; defaults to https://<DOMAIN>/api/login/oauth2/code/microsoft
# MICROSOFT_REDIRECT_URI=

# Optional overrides
# HTTP_PORT=80
# HTTPS_PORT=443
# SESSION_COOKIE_SECURE=true
