# Local backend configuration. NEVER commit .env.
# scripts/env.sh copies this file to .env when .env is missing.

# Entra ID app registration (create at https://entra.microsoft.com)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3001/login/oauth2/code/microsoft

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/curtisdb
SPRING_DATASOURCE_USERNAME=curtisuser
SPRING_DATASOURCE_PASSWORD=curtispass
